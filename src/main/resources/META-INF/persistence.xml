<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.0">

    <!-- Nom du persistence-unit : "default" -->
    <persistence-unit name="firstJPA" transaction-type="RESOURCE_LOCAL">

        <!-- Entity manager provider -->
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <!-- Les entités JPA -->
        <class>ma.fstt.firstjpa.entities.Internaute</class>
        <class>ma.fstt.firstjpa.entities.Panier</class>
        <class>ma.fstt.firstjpa.entities.Commande</class>
        <class>ma.fstt.firstjpa.entities.Produit</class>
        <class>ma.fstt.firstjpa.entities.LignePanier</class>


        <!-- 🗄Configuration de la base de données -->
        <properties>
            <!-- URL de connexion MySQL -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/appMVC2?serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <!-- Génération du schéma -->
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>

            <!-- Activation des logs SQL -->
            <property name="eclipselink.logging.level" value="FINE"/>
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.target-database" value="MySQL"/>
        </properties>

    </persistence-unit>
</persistence>